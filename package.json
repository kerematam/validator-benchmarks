{
  "name": "structured-report-validation-benchmarks",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": "1.3.14"
  },
  "scripts": {
    "benchmark": "bun run src/benchmark/coordinator.ts",
    "benchmark:docker": "sh scripts/benchmark-docker.sh",
    "benchmark:docker-memory": "bun run src/benchmark/docker-memory-coordinator.ts",
    "generate": "bun run src/generator/cli.ts",
    "server": "bun run src/http/server.ts",
    "summarize": "bun run src/benchmark/summarize.ts",
    "privacy:audit": "bun run src/privacy/audit-generated.ts",
    "test": "bun test test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.18.0",
    "hono": "4.12.11",
    "typebox": "1.3.11",
    "valibot": "1.4.2",
    "zod": "4.5.4",
    "zod-4-4": "npm:zod@4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "6.0.2"
  }
}
